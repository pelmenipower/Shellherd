{
  "name": "shellherd",
  "productName": "Shellherd",
  "version": "0.28.0",
  "private": true,
  "description": "Shellherd – a local, encrypted connection manager for SSH, RDP, containers and Kubernetes.",
  "author": "Alexander Schmidt",
  "license": "MIT",
  "homepage": "https://github.com/pelmenipower/Shellherd",
  "repository": {
    "type": "git",
    "url": "https://github.com/pelmenipower/Shellherd.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:rdp-host && npm run build:hello && electron-vite dev",
    "build": "npm run check:version && npm run typecheck && electron-vite build && npm run build:rdp-host && npm run build:hello",
    "check:version": "node scripts/check-version.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:rdp-host": "node scripts/build-rdp-host.mjs",
    "build:hello": "node scripts/build-hello.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release-notes": "node scripts/release-notes.mjs",
    "rdp:try": "node scripts/rdp-try.mjs",
    "icons": "electron scripts/icons/make-icons.mjs",
    "drive": "node .claude/skills/run-app/driver.mjs",
    "drive:sshd": "node .claude/skills/run-app/sshd.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@kubernetes/client-node": "2.0.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "hash-wasm": "4.12.0",
    "i18next": "26.5.2",
    "node-pty": "1.1.0",
    "ssh2": "^1.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@types/node": "24.13.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.2",
    "electron-builder": "26.17.0",
    "electron-vite": "^4.0.0",
    "playwright-core": "1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "17.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "5.0.1",
    "ws": "8.22.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "electron-winstaller@5.4.0": false
  },
  "overrides": {
    "@electron/asar": "4.3.1",
    "global-agent": "^4.1.3"
  }
}
