{
  "name": "Terminus",
  "version": "0.0.1",
  "private": true,
  "description": "A local, encrypted SSH connection manager.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:rdp-host && electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:rdp-host",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:rdp-host": "node scripts/build-rdp-host.mjs",
    "rdp:try": "node scripts/rdp-try.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "crypto": "^1.0.1",
    "hash-wasm": "4.12.0",
    "node-pty": "1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ssh2": "^1.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.4.2",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "5.0.1"
  }
}
