# Run Caddy on the same host. Replace this domain and provide DNS to this host.
# Set SHELLHERD_SERVER_ORIGIN=https://<this domain> for the server: device proofs are bound to that exact origin.
{
    servers {
        timeouts {
            read_header 5s
            read_body 10s
            write 30s
            idle 60s
        }
    }
}

shellherd.example.org {
    request_body {
        max_size 1MiB
    }
    @api path /v1/*
    handle @api {
        # Alternative with the unix socket (compose.socket.yaml): reverse_proxy unix//run/shellherd/server.sock
        reverse_proxy 127.0.0.1:8787 {
            transport http {
                dial_timeout 2s
                response_header_timeout 20s
            }
        }
    }
    handle {
        respond 404
    }
    header -Server
    # Access logging is deliberately not enabled.
}
